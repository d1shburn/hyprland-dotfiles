* {
    bg-col:  #1E1D2F;
    border-col: #1E1D2F;
    blue: #7aa2f7;
    fg-col: #D9E0EE;
    fg-col2: #F28FAD;

    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color: @fg-col;
}

window {
    width: 460px;
    border: 3px;
    border-color: @border-col;
    background-color: @bg-col;
}

mainbox {
    children: [inputbar, listview];
    background-color: @bg-col;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @blue;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 3px;
    margin: 20px 0px 0px 20px;
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
    placeholder: "Search";
}

listview {
    columns: 1;
    lines: 8;
    scrollbar: false;
    padding: 6px 0px 0px;
    margin: 10px 20px 20px 20px;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element selected {
    background-color: @bg-col;
    text-color: @fg-col2;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
